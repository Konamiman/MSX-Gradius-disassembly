# Entry points of bank 0 (runs at 0x4000).
#
# Each one carries the instruction that justifies it. The ones that say
# "pNN:XXXX" come from ANOTHER bank: the single-page tracer cannot follow them,
# because at that address -depending on what is in the mapper register- there
# can be any of five banks. The ones that say "table" come from a table of the
# dispatcher 0x4067, which sits right after its `call` and is declared as data
# in the .nocode: the tracer cannot follow it either.
#
# Jumps and calls WITHIN the bank itself are not listed here:
# tools/z80trace.py finds them on its own, following the flow.
#
# This file is regenerated by `make seeds` (tools/bank_tracer.py write).
0x4028   # H.KEYI interrupt hook: INIT writes 0xC3 to 0xFD9A and this address to 0xFD9B (p00:4095-p00:409D)
0x4062   # p02:801D call
0x4071   # AB header: INIT
0x4100   # p01:6FC6 call
0x47AE   # p02:99A4 call
0x48F7   # p01:6223 jp cc
0x490C   # p01:6226 jp
0x49DE   # p02:9FD7 call
0x4A6D   # p01:7CBD call
0x4ADE   # p00:4AC7 entry 0 of the table at 0x4ACA (call 0x4067 at 0x4AC7)
0x4AFF   # p00:4AC7 entry 1 of the table at 0x4ACA (call 0x4067 at 0x4AC7)
0x4B60   # p00:4AC7 entry 2 of the table at 0x4ACA (call 0x4067 at 0x4AC7)
0x4B82   # p00:4AC7 entry 3 of the table at 0x4ACA (call 0x4067 at 0x4AC7)
0x4BD8   # p00:4AC7 entry 4 of the table at 0x4ACA (call 0x4067 at 0x4AC7)
0x4C16   # p00:4AC7 entry 5 of the table at 0x4ACA (call 0x4067 at 0x4AC7)
0x4C2B   # p00:4AC7 entry 6 of the table at 0x4ACA (call 0x4067 at 0x4AC7)
0x4C62   # p00:4AC7 entry 7 of the table at 0x4ACA (call 0x4067 at 0x4AC7)
0x4C79   # p00:4AC7 entry 8 of the table at 0x4ACA (call 0x4067 at 0x4AC7)
0x4C86   # p00:4AC7 entry 9 of the table at 0x4ACA (call 0x4067 at 0x4AC7)
0x52D7   # p00:52C4 entry 0 of the table at 0x52C7 (call 0x4067 at 0x52C4)
0x5308   # p00:52C4 entry 1 of the table at 0x52C7 (call 0x4067 at 0x52C4)
0x5312   # p00:52C4 entry 2 of the table at 0x52C7 (call 0x4067 at 0x52C4)
0x537D   # p00:52C4 entry 3 of the table at 0x52C7 (call 0x4067 at 0x52C4)
0x53B1   # p00:52C4 entry 4 of the table at 0x52C7 (call 0x4067 at 0x52C4)
0x5464   # p00:52C4 entry 5 of the table at 0x52C7 (call 0x4067 at 0x52C4)
0x546F   # p00:52C4 entry 6 of the table at 0x52C7 (call 0x4067 at 0x52C4)
0x549A   # p00:52C4 entry 7 of the table at 0x52C7 (call 0x4067 at 0x52C4)
0x5506   # RETURN address of the game states: p00:52B7 does `ld hl,0x5506` and `push hl` right before the `call 0x4067` at p00:52C4, so the state that the table dispatches returns here and not to whoever called
0x55B4   # p01:72CF call
0x5E3B   # p00:5DFA entry 16 of the table at 0x5DFD (call 0x4067 at 0x5DFA)
0x5EC8   # p00:5DFA entry 19 of the table at 0x5DFD (call 0x4067 at 0x5DFA)
0x5EE7   # p00:5DFA entry 6 of the table at 0x5DFD (call 0x4067 at 0x5DFA)
0x5F4F   # p00:5DFA entry 13 of the table at 0x5DFD (call 0x4067 at 0x5DFA)
0x5F7C   # p01:65E8 call
0x5FA5   # p01:758E call
