# Puntos de entrada del banco 0 (se ejecuta en 0x4000).
#
# Cada uno lleva la instruccion que lo justifica. Los que ponen "pNN:XXXX"
# vienen de OTRO banco: el trazador de una sola pagina no puede seguirlos,
# porque en esa direccion -segun lo que haya en el registro del mapper- puede
# estar cualquiera de cinco bancos. Los que ponen "tabla" salen de una tabla
# del despachador 0x4067, que va pegada detras de su `call` y esta declarada
# como datos en el .nocode: el trazador tampoco puede seguirla.
#
# Los saltos y llamadas DENTRO del propio banco no se ponen aqui: los
# encuentra tools/z80trace.py solo, siguiendo el flujo.
#
# Este fichero lo regenera `make semillas` (tools/bancos.py escribe).
0x4028   # gancho de interrupcion H.KEYI: INIT escribe 0xC3 en 0xFD9A y esta direccion en 0xFD9B (p00:4095-p00:409D)
0x4062   # p02:801D call
0x4071   # cabecera AB: INIT
0x4100   # p01:6FC6 call
0x47AE   # p02:99A4 call
0x48F7   # p01:6223 jp cc
0x490C   # p01:6226 jp
0x49DE   # p02:9FD7 call
0x4A6D   # p01:7CBD call
0x4ADE   # p00:4AC7 entrada 0 de la tabla de 0x4ACA (call 0x4067 en 0x4AC7)
0x4AFF   # p00:4AC7 entrada 1 de la tabla de 0x4ACA (call 0x4067 en 0x4AC7)
0x4B60   # p00:4AC7 entrada 2 de la tabla de 0x4ACA (call 0x4067 en 0x4AC7)
0x4B82   # p00:4AC7 entrada 3 de la tabla de 0x4ACA (call 0x4067 en 0x4AC7)
0x4BD8   # p00:4AC7 entrada 4 de la tabla de 0x4ACA (call 0x4067 en 0x4AC7)
0x4C16   # p00:4AC7 entrada 5 de la tabla de 0x4ACA (call 0x4067 en 0x4AC7)
0x4C2B   # p00:4AC7 entrada 6 de la tabla de 0x4ACA (call 0x4067 en 0x4AC7)
0x4C62   # p00:4AC7 entrada 7 de la tabla de 0x4ACA (call 0x4067 en 0x4AC7)
0x4C79   # p00:4AC7 entrada 8 de la tabla de 0x4ACA (call 0x4067 en 0x4AC7)
0x4C86   # p00:4AC7 entrada 9 de la tabla de 0x4ACA (call 0x4067 en 0x4AC7)
0x52D7   # p00:52C4 entrada 0 de la tabla de 0x52C7 (call 0x4067 en 0x52C4)
0x5308   # p00:52C4 entrada 1 de la tabla de 0x52C7 (call 0x4067 en 0x52C4)
0x5312   # p00:52C4 entrada 2 de la tabla de 0x52C7 (call 0x4067 en 0x52C4)
0x537D   # p00:52C4 entrada 3 de la tabla de 0x52C7 (call 0x4067 en 0x52C4)
0x53B1   # p00:52C4 entrada 4 de la tabla de 0x52C7 (call 0x4067 en 0x52C4)
0x5464   # p00:52C4 entrada 5 de la tabla de 0x52C7 (call 0x4067 en 0x52C4)
0x546F   # p00:52C4 entrada 6 de la tabla de 0x52C7 (call 0x4067 en 0x52C4)
0x549A   # p00:52C4 entrada 7 de la tabla de 0x52C7 (call 0x4067 en 0x52C4)
0x5506   # direccion de RETORNO de los estados del juego: p00:52B7 hace `ld hl,0x5506` y `push hl` justo antes del `call 0x4067` de p00:52C4, de modo que el estado que despacha la tabla vuelve aqui y no a quien llamo
0x55B4   # p01:72CF call
0x5E3B   # p00:5DFA entrada 16 de la tabla de 0x5DFD (call 0x4067 en 0x5DFA)
0x5EC8   # p00:5DFA entrada 19 de la tabla de 0x5DFD (call 0x4067 en 0x5DFA)
0x5EE7   # p00:5DFA entrada 6 de la tabla de 0x5DFD (call 0x4067 en 0x5DFA)
0x5F4F   # p00:5DFA entrada 13 de la tabla de 0x5DFD (call 0x4067 en 0x5DFA)
0x5F7C   # p01:65E8 call
0x5FA5   # p01:758E call
