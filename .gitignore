# -----------------------------------------------------------------------------
# Work files that are of no use to whoever downloads this
# -----------------------------------------------------------------------------
# They are intermediate dumps and results that `make` regenerates on its own.
#
# Careful with how this is written: plain 'work/' would exclude the whole
# directory and then the '!work/msx.sym' below could NOT rescue anything,
# because git does not look inside an already excluded directory again. With
# 'work/*' it does work.

dump/
build/
work/*
!work/msx.sym

# -----------------------------------------------------------------------------
# The original cartridge
# -----------------------------------------------------------------------------
# The cartridge image is not distributed: everyone supplies their own. The
# commented listing IS included.

*.rom
*.cas
*.dsk
*.wav

# -----------------------------------------------------------------------------
# System and environment junk
# -----------------------------------------------------------------------------
.DS_Store
__pycache__/
*.pyc
.forja/
*.omr
